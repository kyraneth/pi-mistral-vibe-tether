  "keywords": [
    "pi-package",
    "pi",
    "mistral",
    "vibe",
    "acp",
    "provider"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyraneth/pi-mistral-vibe-tether.git"
  },
  "homepage": "https://github.com/kyraneth/pi-mistral-vibe-tether",
  "bugs": {
    "url": "https://github.com/kyraneth/pi-mistral-vibe-tether/issues"
  },
  "author": "kyraneth",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "pi-tether-core": "0.1.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.7.0",
